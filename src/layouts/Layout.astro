---
import { getLang } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  keywords?: string;
}

const lang = getLang(Astro.currentLocale);

const canonicalURL = new URL(Astro.url.pathname, 'https://aidream.com.tw');

const defaults = {
  zh: {
    title: '星智未來｜AI 影片製作公司．中小企業 AI 導入',
    description: '星智未來是 AI 影片製作公司，也幫中小企業做 AI 導入。品牌短劇、廣告影片、包月短影音；以及讓 AI 回答老闆每天在問、卻沒人答得出來的問題。',
    keywords: 'AI 影片製作, AI 影片製作公司, AI 短劇製作, AI 導入, 電子書出版, AI 有聲書, 星智未來',
  },
  en: {
    title: 'AI Dream',
    description: 'AI video production and AI adoption for small businesses.',
    keywords: 'AI video production, AI adoption, AI Dream',
  },
}[lang];

const {
  title = defaults.title,
  description = defaults.description,
  image = '/images/og-image.png',
  type = 'website',
  keywords = defaults.keywords
} = Astro.props;

const siteName = lang === 'en' ? 'AI Dream' : '星智未來 AI Dream';

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '星智未來有限公司',
  alternateName: ['星智未來', 'AI Dream'],
  url: 'https://aidream.com.tw/',
  logo: 'https://aidream.com.tw/logo_removebg.png',
  email: 'service@aidream.com.tw',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: 'service@aidream.com.tw',
    url: 'https://line.me/ti/p/vnlYIFBlYi',
    availableLanguage: 'zh-TW',
  },
};
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-TW'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={siteName} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, 'https://aidream.com.tw')} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_TW'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, 'https://aidream.com.tw')} />

    <!-- Additional Meta -->
    <meta name="theme-color" content="#d0702e" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1410" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- 結構化資料：讓搜尋引擎知道這是哪家公司、怎麼聯絡 -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9KDE00KE7L"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-9KDE00KE7L');
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- 防止 FOUC（主題閃爍） -->
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'light';
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-bg-primary text-text-primary font-sans antialiased transition-colors duration-300">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', 'Noto Sans TC', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  /* 減少動畫（無障礙） */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
