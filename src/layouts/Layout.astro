---
import { getLang, getAlternatePath } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  keywords?: string;
}

const lang = getLang(Astro.currentLocale);

const canonicalURL = new URL(Astro.url.pathname, 'https://aidream.com.tw');
const zhURL = new URL(getAlternatePath(Astro.url.pathname, 'zh'), 'https://aidream.com.tw');
const enURL = new URL(getAlternatePath(Astro.url.pathname, 'en'), 'https://aidream.com.tw');

const defaults = {
  zh: {
    title: '星智未來 AI Dream',
    description: '用 AI 簡化工作的繁瑣，讓 AI 處理瑣事，你專注重要的事。專為微型團隊打造的 AI 工具：Migato AI 塔羅陪伴貓、ContraX 合約管理系統。',
    keywords: 'AI, 人工智慧, 合約管理, ContraX, 中小企業, LINE Bot, 星智未來',
  },
  en: {
    title: 'AI Dream',
    description: 'Let AI handle the busywork so you can focus on what matters. AI tools built for small teams: Migato the AI tarot companion cat and ContraX contract management.',
    keywords: 'AI, artificial intelligence, AI companion, contract management, Migato, ContraX, small business, LINE Bot, AI Dream',
  },
}[lang];

const {
  title = defaults.title,
  description = defaults.description,
  image = '/images/og-image.svg',
  type = 'website',
  keywords = defaults.keywords
} = Astro.props;

const siteName = lang === 'en' ? 'AI Dream' : '星智未來 AI Dream';
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-TW'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={siteName} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="zh-TW" href={zhURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={zhURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, 'https://aidream.com.tw')} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_TW'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'zh_TW' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, 'https://aidream.com.tw')} />

    <!-- Additional Meta -->
    <meta name="theme-color" content="#d0702e" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1410" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9KDE00KE7L"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-9KDE00KE7L');
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- 防止 FOUC（主題閃爍） -->
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'light';
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-bg-primary text-text-primary font-sans antialiased transition-colors duration-300">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', 'Noto Sans TC', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  /* 減少動畫（無障礙） */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
