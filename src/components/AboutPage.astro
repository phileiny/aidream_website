---
import LineCta from './LineCta.astro';

// 2026-10 改版：文字照 docs/改版-2026-10/文案.md〈關於我們〉，寫法同服務頁（explain-ladder 第 1、2 層）
const services = [
  { href: '/services/video/', title: 'AI 影片製作', body: '用 AI 影片幫品牌說故事', icon: 'film' },
  { href: '/services/ai/', title: 'AI 導入', body: '幫中小企業接手最繁瑣的工作', icon: 'chat' },
  { href: '/services/publishing/', title: 'AI 出版', body: '把一本書做成電子書、有聲書和短劇', icon: 'book' },
];

const icons: Record<string, string> = {
  film: 'M4 5h16v14H4zM8 5v14M16 5v14M4 9h4M4 15h4M16 9h4M16 15h4',
  chat: 'M4 5h16v11H8l-4 4V5z',
  book: 'M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2V5zM4 19a2 2 0 0 1 2-2h12',
};

const beliefs = [
  { title: '故事先於技術', body: 'AI 讓畫面變便宜，但觀眾只會為好故事停下來。' },
  { title: '交付要準', body: '報表錯一筆會被退件，影片錯一個 logo 就不是你的品牌。' },
  { title: '速度來自工具', body: '我們先把工具做好，所以能比別人快。' },
];

const people = [
  {
    img: '/images/team/nicole.jpg',
    name: '妮可',
    role: '編劇與品質確認',
    note: '星智未來負責人',
    facts: ['八年影視企劃、十年品牌策略', 'Migato《轉動之輪》的故事與旁白，由她寫、由她配音'],
    credits: '參與過福斯原創影集《愛的廣義相對論——明晚空中見》、Netflix 原創影集《急診室的奇蹟》、電影《月老》企劃、電影《乩身》企劃與編劇。',
  },
  {
    img: '/images/team/ray.jpg',
    name: '瑞導',
    role: '導演與製作',
    note: '',
    facts: ['25 年系統整合與軟體開發', '《矽谷之戀》的導演；黑客松門店 AI 代理的開發者'],
    credits: '做過醫療 IoT 平台、微軟 AppSource 上架的 SaaS，主導過 ISO 27001／27701／27017／27018 四項資安認證。',
  },
];

const info = [
  ['公司名稱', '星智未來有限公司（AI Dream）'],
  ['成立', '團隊 2019 年開始服務客戶；2025 年成立公司'],
  ['服務項目', 'AI 影片製作、中小企業 AI 導入、AI 出版'],
  ['服務對象', '品牌、行銷公司、中小企業、作者'],
  ['聯絡', 'LINE @243olfpn｜service@aidream.com.tw'],
];

const dot = 'mt-3 w-2 h-2 rounded-full bg-primary flex-shrink-0';
---

<main class="pt-16 md:pt-20">
  <!-- 封面 -->
  <section class="py-20 md:py-28 bg-deep">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <p class="text-lg md:text-xl font-semibold tracking-wider text-gold mb-4">關於星智未來</p>
      <h1 class="text-[2rem] leading-snug md:text-6xl md:leading-tight font-bold text-[#f5f0eb]"><span class="inline-block">用 AI 說故事，</span><span class="inline-block">也用 AI 把事情做完</span></h1>
      <div class="mt-8 space-y-2 text-lg md:text-xl leading-[1.8] text-[#e6ddd2]">
        <p>團隊從 2019 年開始服務客戶，2025 年成立公司。</p>
        <p>我們一開始做 AI 工具。</p>
        <p>後來發現，客戶要的不是工具本身，</p>
        <p>是「這件事有人負責，而且很快」。</p>
      </div>
    </div>
  </section>

  <!-- 現在做三件事 -->
  <section class="py-16 md:py-20 bg-bg-primary">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-text-primary">所以我們現在做三件事</h2>
      <div class="mt-12 grid md:grid-cols-3 gap-6">
        {services.map(s => (
          <a href={s.href} class="group p-8 rounded-2xl bg-bg-secondary border border-border text-center hover:shadow-xl transition-shadow">
            <span class="mx-auto w-16 h-16 rounded-full bg-primary text-white flex items-center justify-center shadow-md">
              <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[s.icon]} /></svg>
            </span>
            <h3 class="mt-5 text-2xl font-bold text-text-primary group-hover:text-primary transition-colors">{s.title}</h3>
            <p class="mt-2 text-lg leading-relaxed text-text-primary">{s.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 我們相信 -->
  <section class="py-16 md:py-20 bg-bg-secondary">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-text-primary">我們相信</h2>
      <div class="mt-12 grid md:grid-cols-3 gap-6">
        {beliefs.map(b => (
          <div class="p-8 rounded-2xl bg-bg-primary border border-border">
            <h3 class="text-2xl font-bold text-primary">{b.title}</h3>
            <p class="mt-3 text-lg leading-[1.8] text-text-primary">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 誰會跟你合作 -->
  <section class="py-16 md:py-24 bg-bg-primary">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-text-primary">誰會跟你合作</h2>
      <div class="mt-12 grid md:grid-cols-2 gap-8">
        {people.map(p => (
          <div class="p-8 rounded-2xl bg-bg-secondary border border-border">
            <div class="flex items-center gap-5">
              <img src={p.img} alt={`${p.name}，${p.role}`} loading="lazy" class="w-28 h-28 md:w-32 md:h-32 rounded-full object-cover shadow-lg ring-4 ring-bg-primary flex-shrink-0" />
              <div>
                <h3 class="text-3xl font-bold text-text-primary">{p.name}</h3>
                <p class="mt-1 text-lg font-semibold text-primary-dark dark:text-gold">{p.role}</p>
                {p.note && <p class="text-base text-text-secondary">{p.note}</p>}
              </div>
            </div>
            <ul class="mt-6 space-y-2 text-lg leading-[1.8] text-text-primary">
              {p.facts.map(f => <li class="flex gap-3"><span class={dot}></span><span>{f}</span></li>)}
            </ul>
            <p class="mt-4 text-base leading-[1.8] text-text-secondary">{p.credits}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 也接演講、企業內訓 -->
  <section class="py-16 md:py-20 bg-bg-secondary">
    <div class="max-w-4xl mx-auto px-4">
      <div class="gold-box p-8 md:p-10 rounded-2xl">
        <h2 class="text-2xl md:text-3xl font-bold text-text-primary">也接演講、企業內訓、工作坊</h2>
        <p class="mt-4 text-lg md:text-xl leading-[1.8] text-text-primary">AI 影片怎麼說故事、中小企業怎麼開始 AI 導入，我們也到企業、學校分享。</p>
        <a href="https://line.me/ti/p/vnlYIFBlYi" target="_blank" rel="noopener" class="mt-6 inline-block px-7 py-3 bg-primary hover:bg-primary-dark text-white font-semibold text-lg rounded-full transition-all hover:-translate-y-0.5">加 LINE 詢問</a>
      </div>
    </div>
  </section>

  <!-- 公司資訊 -->
  <section class="py-16 md:py-20 bg-bg-primary">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-text-primary">公司資訊</h2>
      <dl class="mt-10 border-y border-border">
        {info.map(([k, v]) => (
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 py-4 border-b border-border last:border-0">
            <dt class="sm:w-32 flex-shrink-0 text-lg font-bold text-text-primary">{k}</dt>
            <dd class="text-lg text-text-primary">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <LineCta title="你手上那件事，我們可以一起想" />
</main>

<style>
  .gold-box {
    background: rgba(198, 165, 101, 0.12);
    border-left: 4px solid var(--color-gold);
  }

  :global(.dark) .gold-box {
    background: rgba(198, 165, 101, 0.08);
  }
</style>
