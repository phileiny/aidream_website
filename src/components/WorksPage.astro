---
import { getLang, localizePath } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);

const content = {
  zh: {
    title: 'AI 影片作品',
    intro1: '從 30 秒短影音到 10 集網路劇，從商品展示到品牌故事。',
    intro2: '每一支都保留客戶的品牌細節，不是套模板。',
    playLabel: '播放影片：',
    thumbnailSuffix: ' 影片縮圖',
    tagSeparator: '｜',
    makingLabel: '製作時間：',
    resultLabel: '成效',
    demoLabel: '示範作品',
    github: '我們把 AI 影片的製作方法整理成公開技術文件，於 GitHub 獲得 169 位開發者收藏',
    ctaTitle: '您的第一支影片，我們可以一起想',
    ctaBody: '不必一次押大。挑一條產品線或一個主題，試行一個月，用數據決定要不要繼續。',
    lineButton: '加 LINE 聊聊',
    lineButtonAria: '加 LINE 聊聊（另開新視窗）',
    contact: '聯繫我們',
    qrAria: '加入星智未來 LINE（另開新視窗）',
    qrAlt: '星智未來 LINE QR code',
    qrCaption: '掃描加 LINE',
    works: [
      {
        number: '作品一',
        title: '木柵順便傳說 #1〈動物園逃脫事件〉',
        videoId: 'yP1UiVHHL4w',
        vertical: true,
        tags: [
          { label: '類型', value: '在地短影音／喜劇' },
          { label: '用途', value: '店家社群經營、在地知名度' },
          { label: '規格', value: '30 秒．直式 1080×1920' },
        ],
        making: '腳本到完成版約 3.5 小時（粗剪 2 小時、完成版 1.5 小時）',
        paragraphs: [
          '一隻大貓熊為了一碗北海道風・奶油牛奶味噌拉麵，從動物園逃了出來。系列目的是建立記憶點，讓來木柵的人想到這家店。',
          '全片 AI 生成，但圍裙上的 logo、牆上的主視覺、那碗拉麵的配料，都以店內實際的樣子為準。',
        ],
        result: '上架後的第一個週二，該店營業額從前三週平均約 7,500 元提升到 <strong>15,447 元</strong>（店家 POS 數據，單週觀察）。影片觀看 5,423 次。',
      },
      {
        number: '作品二',
        title: 'Migato《轉動之輪》',
        videoId: 'j5kpw6pp20M',
        vertical: true,
        tags: [
          { label: '類型', value: '品牌故事／情感敘事' },
          { label: '用途', value: '產品世界觀、群眾募資前導' },
          { label: '規格', value: '57 秒．直式 1080×1920' },
        ],
        paragraphs: [
          '燭光、塔羅牌、一位老婆婆，和一隻會發光的貓。同樣的製作方式，這一次要的不是笑聲，是鼻酸。',
        ],
      },
      {
        number: '作品三',
        title: '服飾品項短片',
        videoId: 'Iy9D0sYkjoo',
        vertical: true,
        tags: [
          { label: '類型', value: '商品展示' },
          { label: '用途', value: '電商商品頁、廣告素材' },
          { label: '規格', value: '7 秒．直式' },
        ],
        paragraphs: [
          '單一商品、單一場景、固定版型。模特兒與背景一次設定，之後每個品項都能批次產出，二十支看起來仍是同一個品牌。',
          '適合品項多的產業：服飾、伴手禮、五金、食品。',
        ],
      },
      {
        number: '作品四',
        title: '《矽谷之戀》第一集 序場',
        videoId: 'WPFGsm3vYh8',
        vertical: false,
        tags: [
          { label: '類型', value: '戲劇／網路劇' },
          { label: '用途', value: '小說改編、IP 開發' },
          { label: '規格', value: '40 秒（序場）．橫式' },
        ],
        paragraphs: [
          '2000 年代的矽谷，展開了一段遺憾的戀情。序場從兩個工程師談成人生第一筆大單開始：空拍進園區、開香檳、辦公室對戲、晶圓特寫，一路收到片名卡。',
          '改編自 JD 2002.10.30 同名小說。角色在不同鏡頭之間保持一致，是長篇敘事最難的一關。本片為 10 集網路劇的第一集開場。',
        ],
      },
      {
        number: '作品五',
        title: '《琦琦的幽靈嗅》',
        videoId: '-AzzHISb2UM',
        vertical: true,
        tags: [
          { label: '類型', value: '懸疑短劇' },
          { label: '用途', value: '自有 IP、系列內容開發' },
          { label: '規格', value: '直式短影音' },
        ],
        paragraphs: [
          '琦琦聞得到別人聞不到的氣味。醫生說那叫幻嗅，她知道那是另一個世界傳來的訊息。台灣原創的 AI 懸疑短劇。',
        ],
      },
      {
        number: '作品六',
        title: '武俠動作示範〈一刀〉',
        videoId: '0EpMGEa70Wk',
        vertical: false,
        demo: true,
        tags: [
          { label: '類型', value: '武俠／動作' },
          { label: '用途', value: '類型示範、IP 開發' },
          { label: '規格', value: '24 秒．橫式 1376×768' },
        ],
        paragraphs: [
          '黃沙、逆光、兩人對峙。「你看見刀的時候，已經晚了。」',
          '動作戲是 AI 影片最難的一塊：模型做不出接觸的因果，刀碰不到刀。這支片的做法是不拍接觸，只拍前後——越肩構圖遮住接觸點，情緒交給眼神特寫，結果留給背影與留白。',
        ],
      },
    ],
  },
  en: {
    title: 'AI Video Works',
    intro1: 'From 30-second shorts to a 10-episode web series, from product showcases to brand stories.',
    intro2: 'Every piece keeps the client\'s brand details intact — no cookie-cutter templates.',
    playLabel: 'Play video: ',
    thumbnailSuffix: ' video thumbnail',
    tagSeparator: ' | ',
    makingLabel: 'Production time: ',
    resultLabel: 'Results',
    demoLabel: 'Demo',
    github: 'We\'ve published our AI video production method as open technical documentation, starred by 169 developers on GitHub',
    ctaTitle: 'Let\'s plan your first video together',
    ctaBody: 'No need to bet big up front. Pick one product line or theme, run a one-month pilot, and let the data decide whether to keep going.',
    lineButton: 'Chat with us on LINE',
    lineButtonAria: 'Chat with us on LINE (opens in a new window)',
    contact: 'Contact Us',
    qrAria: 'Add AI Dream on LINE (opens in a new window)',
    qrAlt: 'AI Dream LINE QR code',
    qrCaption: 'Scan to add us on LINE',
    works: [
      {
        number: 'Work 01',
        title: 'Muzha Drop-By Legends #1: The Great Zoo Escape',
        videoId: 'yP1UiVHHL4w',
        vertical: true,
        tags: [
          { label: 'Genre', value: 'Local short video / Comedy' },
          { label: 'Purpose', value: 'Store social media, local awareness' },
          { label: 'Format', value: '30 sec · Vertical 1080×1920' },
        ],
        making: 'About 3.5 hours from script to final cut (2 hours for the rough cut, 1.5 hours for the final)',
        paragraphs: [
          'A giant panda breaks out of the zoo for a bowl of Hokkaido-style butter-milk miso ramen. The series is designed to be memorable, so people visiting Muzha think of this restaurant.',
          'The entire video is AI-generated, yet the logo on the apron, the key visual on the wall, and the toppings on the ramen all match what\'s actually in the shop.',
        ],
        result: 'On the first Tuesday after release, the restaurant\'s revenue rose from an average of about NT$7,500 over the previous three weeks to <strong>NT$15,447</strong> (store POS data, single-week observation). The video received 5,423 views.',
      },
      {
        number: 'Work 02',
        title: 'Migato: The Turning Wheel',
        videoId: 'j5kpw6pp20M',
        vertical: true,
        tags: [
          { label: 'Genre', value: 'Brand story / Emotional narrative' },
          { label: 'Purpose', value: 'Product world-building, crowdfunding teaser' },
          { label: 'Format', value: '57 sec · Vertical 1080×1920' },
        ],
        paragraphs: [
          'Candlelight, tarot cards, an old woman, and a glowing cat. Same production approach — but this time, the goal isn\'t laughter. It\'s a lump in your throat.',
        ],
      },
      {
        number: 'Work 03',
        title: 'Apparel Product Clips',
        videoId: 'Iy9D0sYkjoo',
        vertical: true,
        tags: [
          { label: 'Genre', value: 'Product showcase' },
          { label: 'Purpose', value: 'E-commerce product pages, ad creatives' },
          { label: 'Format', value: '7 sec · Vertical' },
        ],
        paragraphs: [
          'One product, one scene, one fixed template. Set up the model and background once, then batch-produce a clip for every item — twenty videos that still look like one brand.',
          'Ideal for businesses with large catalogs: apparel, souvenirs, hardware, and food.',
        ],
      },
      {
        number: 'Work 04',
        title: 'Silicon Valley Love Story, Episode 1 — Opening Scene',
        videoId: 'WPFGsm3vYh8',
        vertical: false,
        tags: [
          { label: 'Genre', value: 'Drama / Web series' },
          { label: 'Purpose', value: 'Novel adaptation, IP development' },
          { label: 'Format', value: '40 sec (opening) · Horizontal' },
        ],
        paragraphs: [
          'Silicon Valley in the 2000s, where a love story full of regret begins. The opening follows two engineers closing the first big deal of their lives: an aerial shot into the campus, a champagne toast, a scene in the office, a close-up of a wafer, all the way to the title card.',
          'Adapted from the novel of the same name by JD 2002.10.30. Keeping characters consistent from shot to shot is the hardest part of long-form storytelling. This is the opening of Episode 1 of a 10-episode web series.',
        ],
      },
      {
        number: 'Work 05',
        title: 'Chi-Chi\'s Phantom Scent',
        videoId: '-AzzHISb2UM',
        vertical: true,
        tags: [
          { label: 'Genre', value: 'Mystery short drama' },
          { label: 'Purpose', value: 'Original IP, series development' },
          { label: 'Format', value: 'Vertical short video' },
        ],
        paragraphs: [
          'Chi-Chi can smell things no one else can. Her doctor calls it phantosmia; she knows they\'re messages from another world. An original Taiwanese AI mystery short drama.',
        ],
      },
      {
        number: 'Work 06',
        title: 'Wuxia Action Demo: One Blade',
        videoId: '0EpMGEa70Wk',
        vertical: false,
        demo: true,
        tags: [
          { label: 'Genre', value: 'Wuxia / Action' },
          { label: 'Purpose', value: 'Genre showcase, IP development' },
          { label: 'Format', value: '24 sec · Horizontal 1376×768' },
        ],
        paragraphs: [
          'Yellow sand, backlight, two fighters facing off. "By the time you see the blade, it\'s already too late."',
          'Action is the hardest thing to pull off in AI video: models can\'t render the cause and effect of contact — blades never quite meet. So this piece doesn\'t film the contact, only what comes before and after. Over-the-shoulder framing hides the point of impact, close-ups on the eyes carry the emotion, and the outcome is left to a figure walking away and the silence that follows.',
        ],
      },
    ],
  },
}[lang];

const works = content.works;
---

<main class="pt-20">
  <!-- 頁首 -->
  <section class="py-20 md:py-28 bg-bg-secondary relative overflow-hidden">
    <div class="absolute inset-0 opacity-30 dark:opacity-20">
      <div class="absolute top-10 right-20 w-80 h-80 bg-primary/20 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 left-10 w-64 h-64 bg-gold/20 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-text-primary">
        {content.title}
      </h1>
      <p class="text-lg md:text-xl leading-[1.8] text-text-secondary max-w-2xl mx-auto">
        {content.intro1}<br />
        {content.intro2}
      </p>
    </div>
  </section>

  <!-- 作品區塊 -->
  {works.map((work, index) => (
    <section class={`py-16 md:py-24 ${index % 2 === 0 ? 'bg-bg-primary' : 'bg-bg-secondary'}`}>
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
          <!-- 影片：奇數個在左、偶數個在右 -->
          <div class={index % 2 === 1 ? 'md:order-2' : ''}>
            <div
              class={`video-frame relative overflow-hidden rounded-2xl shadow-xl mx-auto ${work.vertical ? 'is-vertical max-w-xs sm:max-w-sm' : 'is-horizontal w-full'}`}
            >
              <button
                type="button"
                class="lite-yt group absolute inset-0 w-full h-full cursor-pointer"
                data-id={work.videoId}
                data-title={work.title}
                aria-label={`${content.playLabel}${work.title}`}
              >
                <img
                  src={`https://i.ytimg.com/vi/${work.videoId}/hqdefault.jpg`}
                  alt={`${work.title}${content.thumbnailSuffix}`}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover"
                />
                <span class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors"></span>
                <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-16 h-16 md:w-20 md:h-20 rounded-full bg-primary text-white flex items-center justify-center shadow-lg transition-transform group-hover:scale-110">
                  <svg class="w-7 h-7 md:w-8 md:h-8 ml-1" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </button>
            </div>
          </div>

          <!-- 文字 -->
          <div class={index % 2 === 1 ? 'md:order-1' : ''}>
            <p class="text-primary font-semibold mb-2">
              {work.number}
              {work.demo && (
                <span class="ml-2 px-3 py-1 text-sm font-medium rounded-full bg-primary/5 text-primary/70 dark:bg-primary/10">
                  {content.demoLabel}
                </span>
              )}
            </p>
            <h2 class="text-2xl md:text-3xl font-bold mb-5 text-text-primary">{work.title}</h2>

            <ul class="flex flex-wrap gap-2 mb-6">
              {work.tags.map(tag => (
                <li class="px-3 py-1 text-base rounded-full bg-primary/10 text-primary dark:bg-primary/20">
                  <span class="font-semibold">{tag.label}</span>{content.tagSeparator}{tag.value}
                </li>
              ))}
            </ul>

            <div class="space-y-4 text-[17px] md:text-lg leading-[1.8] text-text-primary">
              {work.paragraphs.map(p => <p>{p}</p>)}
            </div>

            {work.making && (
              <p class="mt-4 text-[17px] leading-[1.8] text-text-secondary">
                <span class="font-semibold">{content.makingLabel}</span>{work.making}
              </p>
            )}

            {work.result && (
              <div class="result-box mt-6 p-5 md:p-6 rounded-xl">
                <p class="text-sm font-semibold tracking-wide text-gold-dark dark:text-gold mb-2">{content.resultLabel}</p>
                <p class="text-[17px] md:text-lg leading-[1.8] text-text-primary" set:html={work.result} />
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- 行動呼籲 -->
  <section class="py-20 md:py-28 bg-deep dark:bg-space">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <p class="mb-8 text-base leading-[1.8] text-[#c6b8a8]">
        <a
          href="https://github.com/phileiny/h3-storyboard-skill"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 hover:text-gold transition-colors"
        >
          <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.73.5.75 5.48.75 11.75c0 4.97 3.22 9.18 7.69 10.67.56.1.77-.24.77-.54v-1.9c-3.13.68-3.79-1.51-3.79-1.51-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.28.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.24 1.16-3.03-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.16a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.1-1.16 3.1-1.16.61 1.55.23 2.7.11 2.98.72.79 1.16 1.8 1.16 3.03 0 4.33-2.64 5.28-5.15 5.56.4.35.76 1.03.76 2.08v3.08c0 .3.2.65.78.54 4.46-1.49 7.68-5.7 7.68-10.67C23.25 5.48 18.27.5 12 .5z" />
          </svg>
          <span>{content.github}</span>
        </a>
      </p>
      <h2 class="text-3xl md:text-4xl font-bold mb-6 text-[#f5f0eb]">
        {content.ctaTitle}
      </h2>
      <p class="text-lg leading-[1.8] text-[#c6b8a8] mb-10">
        {content.ctaBody}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-10">
        <a
          href="https://line.me/ti/p/vnlYIFBlYi"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-[#06C755] hover:bg-[#05b04c] text-white font-semibold text-lg rounded-full transition-all hover:-translate-y-0.5"
          aria-label={content.lineButtonAria}
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
          </svg>
          {content.lineButton}
        </a>
        <a
          href={localizePath('/contact', lang)}
          class="inline-block px-8 py-4 border-2 border-gold text-gold hover:bg-gold hover:text-deep font-semibold text-lg rounded-full transition-all hover:-translate-y-0.5"
        >
          {content.contact}
        </a>
      </div>
      <!-- 手機用戶直接點 LINE 按鈕即可，QR code 只給桌機掃 -->
      <figure class="hidden md:block">
        <a href="https://line.me/ti/p/vnlYIFBlYi" target="_blank" rel="noopener" aria-label={content.qrAria} class="inline-block">
          <img
            src="/images/line-qr.png"
            alt={content.qrAlt}
            width="140"
            height="140"
            loading="lazy"
            class="mx-auto w-[140px] h-auto rounded-lg"
          />
        </a>
        <figcaption class="mt-2 text-base text-[#c6b8a8]">{content.qrCaption}</figcaption>
      </figure>
    </div>
  </section>
</main>

<style>
  .video-frame.is-vertical {
    aspect-ratio: 9 / 16;
  }

  .video-frame.is-horizontal {
    aspect-ratio: 16 / 9;
  }

  .video-frame {
    background: #000;
  }

  .result-box {
    background: rgba(198, 165, 101, 0.1);
    border-left: 4px solid var(--color-gold);
  }

  :global(.dark) .result-box {
    background: rgba(198, 165, 101, 0.08);
  }

  .result-box :global(strong) {
    font-size: 1.35em;
    color: var(--color-primary);
  }
</style>

<script>
  // lite embed：點擊後才載入 YouTube iframe，避免五個 iframe 拖慢首屏
  document.querySelectorAll<HTMLButtonElement>('.lite-yt').forEach(button => {
    button.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${button.dataset.id}?autoplay=1`;
      iframe.title = button.dataset.title ?? '';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 w-full h-full';
      button.replaceWith(iframe);
    });
  });
</script>
