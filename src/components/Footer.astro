---
// 頁尾：2026-10 改版，對齊三條服務（AI 影片製作、AI 導入、AI 出版）
const currentYear = new Date().getFullYear();
const lineUrl = 'https://line.me/ti/p/vnlYIFBlYi';

const columns = [
  {
    title: '服務',
    links: [
      { label: 'AI 影片製作', href: '/services/video/' },
      { label: 'AI 導入', href: '/services/ai/' },
      { label: 'AI 出版', href: '/services/publishing/' },
    ],
  },
  {
    title: '公司',
    links: [
      { label: '作品', href: '/services/video/#works' },
      { label: '關於我們', href: '/about/' },
      { label: '聯繫我們', href: '/contact/' },
      { label: '部落格', href: 'https://blog.aidream.com.tw', external: true },
      { label: 'Migato 米果', href: '/products/migato/' },
    ],
  },
];
---

<footer class="bg-bg-primary border-t border-border">
  <div class="max-w-6xl mx-auto px-4 py-12 md:py-16">
    <div class="grid md:grid-cols-4 gap-10 md:gap-12">
      <!-- 品牌資訊 -->
      <div class="md:col-span-2">
        <a href="/" class="text-2xl font-bold text-text-primary hover:text-primary transition-colors">
          星智未來 AI Dream
        </a>
        <p class="mt-4 text-text-secondary max-w-sm leading-[1.8]">
          用 AI 說故事，也用 AI 把事情做完。
        </p>
        <ul class="mt-6 space-y-2 text-text-secondary">
          <li>LINE　<a href={lineUrl} target="_blank" rel="noopener" class="hover:text-primary transition-colors">@243olfpn</a></li>
          <li>Email　<a href="mailto:service@aidream.com.tw" class="hover:text-primary transition-colors">service@aidream.com.tw</a></li>
        </ul>
      </div>

      {columns.map(col => (
        <div>
          <h4 class="font-semibold mb-4 text-text-primary">{col.title}</h4>
          <ul class="space-y-3">
            {col.links.map(link => (
              <li>
                <a
                  href={link.href}
                  class="text-text-secondary hover:text-primary transition-colors"
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- 版權聲明 -->
    <div class="mt-12 pt-8 border-t border-border text-center text-text-muted text-sm">
      <p>&copy; {currentYear} 星智未來有限公司 AI Dream. All rights reserved.</p>
    </div>
  </div>
</footer>
