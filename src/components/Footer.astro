---
import { getLang, localizePath, lineStickerUrl } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const currentYear = new Date().getFullYear();

const content = {
  zh: {
    tagline: '用 AI 簡化工作的繁瑣，讓 AI 處理瑣事，你專注重要的事。',
    productsTitle: '產品',
    companyTitle: '公司',
    sticker: 'LINE 貼圖',
    about: '關於我們',
    contact: '聯繫我們',
    blog: '部落格',
    copyright: '星智未來 AI Dream',
  },
  en: {
    tagline: 'Let AI handle the busywork, so you can focus on what matters.',
    productsTitle: 'Products',
    companyTitle: 'Company',
    sticker: 'LINE Stickers',
    about: 'About',
    contact: 'Contact',
    blog: 'Blog',
    copyright: 'AI Dream',
  },
}[lang];

const links = {
  products: [
    { label: 'Migato', href: localizePath('/products/migato', lang) },
    { label: content.sticker, href: lineStickerUrl[lang], external: true },
    { label: 'ContraX', href: localizePath('/products/contrax', lang) },
  ],
  company: [
    { label: content.about, href: localizePath('/about', lang) },
    { label: content.contact, href: localizePath('/contact', lang) },
    { label: content.blog, href: 'https://blog.aidream.com.tw', external: true },
  ],
};
---

<footer class="bg-bg-primary border-t border-border">
  <div class="max-w-6xl mx-auto px-4 py-12 md:py-16">
    <div class="grid md:grid-cols-4 gap-8 md:gap-12">
      <!-- 品牌資訊 -->
      <div class="md:col-span-2">
        <a href={localizePath('/', lang)} class="text-2xl font-bold text-text-primary hover:text-primary transition-colors">
          AI Dream
        </a>
        <p class="mt-4 text-text-secondary max-w-sm">
          {content.tagline}
        </p>
      </div>

      <!-- 產品連結 -->
      <div>
        <h4 class="font-semibold mb-4 text-text-primary">{content.productsTitle}</h4>
        <ul class="space-y-3">
          {links.products.map(link => (
            <li>
              <a
                href={link.href}
                class="text-text-secondary hover:text-primary transition-colors"
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- 公司連結 -->
      <div>
        <h4 class="font-semibold mb-4 text-text-primary">{content.companyTitle}</h4>
        <ul class="space-y-3">
          {links.company.map(link => (
            <li>
              <a
                href={link.href}
                class="text-text-secondary hover:text-primary transition-colors"
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- 版權聲明 -->
    <div class="mt-12 pt-8 border-t border-border text-center text-text-muted text-sm">
      <p>&copy; {currentYear} {content.copyright}. All rights reserved.</p>
    </div>
  </div>
</footer>
